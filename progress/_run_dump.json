            "config": {
              "prompt": "{{loopShot.item.visual}}（统一纪录片/资讯风：写实、干净、信息图质感；竖版构图）",
              "providerConfigId": "{{start.imageProviderConfigId}}",
              "modelId": "{{start.imageModelId}}",
              "width": "{{start.width}}",
              "height": "{{start.height}}",
              "promptExtend": false
            }
          },
          {
            "id": "vid1",
            "type": "video-gen",
            "name": "图生视频(动化)",
            "position": {
              "x": 1320,
              "y": 320
            },
            "config": {
              "providerConfigId": "{{start.videoProviderConfigId}}",
              "model": "{{start.videoModelId}}",
              "image": "{{img1.images.0.localUrl}}",
              "prompt": "{{loopShot.item.visual}} 生成连贯自然运动",
              "duration": "{{loopShot.item.duration}}",
              "width": "{{start.width}}",
              "height": "{{start.height}}"
