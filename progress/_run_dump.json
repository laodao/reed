            "config": {
              "systemPrompt": "你是视频分镜师。把短视频脚本解析为可执行的镜头序列，只输出 JSON：{\"narration\":\"完整口播文案(原样保留，可用 | 分隔句中停顿)\",\"shots\":[{\"visual\":\"画面描述(具体可执行: 主体/场景/光线/景别/运镜)\",\"caption\":\"该镜头字幕(短句)\",\"duration\":\"该镜头时长(秒，数字)\"}]}。时长按脚本分镜表；脚本未分时按口播句均分。镜头数按脚本实际分镜，最多 20。",
              "prompt": "脚本：\n{{start.script}}\n\n请输出镜头序列 JSON，不要任何解释。",
              "jsonMode": true,
              "providerConfigId": "{{start.model.providerConfigId}}",
              "modelId": "{{start.model.modelId}}"
            }
          },
          {
            "id": "htmlPre",
            "type": "code",
            "name": "素材预览存档",
            "position": {
              "x": 560,
              "y": 400
            },
            "config": {
              "code": "const shots=inputs.shots||[]; const html='<h3>素材预览</h3><div>'+(shots.map((x,i)=>'<div style=\"margin:6px 0\"><b>镜头'+(i+1)+'</b> · 时长'+(x.duration||'')+'s<br>画面：'+(x.visual||'')+'<br>字幕：'+(x.caption||'')+'</div>').join(''))+'</div>'; return { html }",
              "inputs": {
                "shots": "{{parse1.parsed.shots}}"
              }
            }
          },
          {
            "id": "loopShot",
            "type": "loop",
            "name": "逐镜头生成画面",
            "position": {
              "x": 820,
              "y": 400
            },
            "config": {
              "listExpression": "{{parse1.parsed.shots}}",
              "emptyPolicy": "skip",
              "errorPolicy": "fail"
            }
          },
          {
            "id": "img1",
            "type": "image-gen",
            "name": "文生图(镜头画面)",
            "position": {
              "x": 1060,
              "y": 320
