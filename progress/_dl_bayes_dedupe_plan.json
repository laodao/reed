    {
      "names": [
        "三明治方差（sandwich variance）",
        "夹心方差（sandwich variance）"
      ],
      "members": [
        {
          "id": "18964cc0-f991-4e90-a08c-c06f3af0523f",
          "name": "三明治方差（sandwich variance）",
          "en": "sandwich variance",
          "parent": "验收·贝叶斯入门·领域根",
          "createdAt": "2026-09-11 08:52:22.355",
          "cards": "v2/draft,v1/draft",
          "cardLen": 7281,
          "rel": 8,
          "q": 0,
          "note": 0,
          "log": 0,
          "def": "错误指定下极大似然估计的渐近抽样方差（Huber 1967 提出）：面包-肉-面包 H_inv * J * H_inv，其中 H 为对数似然的曲率、J 为得分的外积和；使估计量在模型错误指定时仍能做近似正确的区间估计。"
        },
        {
          "id": "7326af84-e9ef-46c6-bf50-09662539c585",
          "name": "夹心方差（sandwich variance）",
          "en": "sandwich variance",
          "parent": "验收·贝叶斯入门·领域根",
          "createdAt": "2026-09-11 08:42:25.804",
          "cards": "v1/draft",
          "cardLen": 7547,
          "rel": 7,
          "q": 0,
          "note": 0,
          "log": 0,
          "def": "Huber(1967)/White(1980) 提出的稳健方差公式 V = A⁻¹ B A⁻¹：用「面包」A（模型假定的信息量）夹住「肉」B（实际得分外积），模型被错误指定时仍能渐近正确地刻画 MLE 的抽样分布。"
        }
      ]
    },
