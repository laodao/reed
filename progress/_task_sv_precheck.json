{
  "def": {
    "id": "builtin_def_script-to-video",
    "name": "[内置] 短视频脚本生成视频",
    "templateVersion": 1,
    "nodeIds": [
      "start:start",
      "parse1:llm-chat",
      "htmlPre:code",
      "loopShot:loop",
      "img1:image-gen",
      "review1:human-review",
      "vid1:video-gen",
      "tts1:tts",
      "code1:code",
      "comp1:video-compose",
      "save1:save-asset",
      "saveXml:save-asset",
      "end:end"
    ],
    "edgeKinds": [
      "start->parse1:normal",
      "parse1->htmlPre:normal",
      "htmlPre->loopShot:normal",
      "loopShot->img1:loop-body",
      "img1->review1:normal",
      "review1->vid1:approve",
      "vid1->loopShot:loop-back",
      "loopShot->tts1:loop-done",
      "tts1->code1:normal",
      "code1->comp1:normal",
      "comp1->save1:normal",
      "save1->saveXml:normal",
      "saveXml->end:normal"
    ],
    "startInputs": [
      "script",
      "videoStyle",
      "styleReferenceImage",
      "videoProviderConfigId",
      "videoModelId",
      "imageProviderConfigId",
      "imageModelId",
      "voiceId",
      "voiceProviderConfigId",
      "width",
      "height",
      "bgmPath",
      "model"
    ],
    "review1Editable": [
      {
        "key": "visual"
      },
      {
        "key": "caption"
      },
      {
        "key": "duration"
      }
    ],
    "vid1": {
      "providerConfigId": "{{start.videoProviderConfigId}}",
      "model": "{{start.videoModelId}}",
      "image": "{{img1.images.0.localUrl}}",
      "prompt": "{{review1.visual}} 镜头风格：{{start.videoStyle}}。保持首帧主体一致，生成连贯自然运动（运动幅度与画面描述一致，避免剧烈形变）",
      "negativePrompt": "画面扭曲、形变、闪烁、乱码文字、多余文字",
      "duration": "{{review1.duration}}",
      "width": "{{start.width}}",
      "height": "{{start.height}}"
    },
    "img1": {
      "prompt": "{{loopShot.item.visual}}（整体风格：{{start.videoStyle}}；竖版构图；写实、干净、无任何文字）",
      "negativePrompt": "文字、字体、logo、水印、UI 元素、图标、按钮、弹窗、乱码、涂鸦、图形、表格、图表、标注、贴片字幕、卡通",
      "providerConfigId": "{{start.imageProviderConfigId}}",
      "modelId": "{{start.imageModelId}}",
      "width": "{{start.width}}",
      "height": "{{start.height}}",
      "referenceImages": "{{start.styleReferenceImage}}",
      "promptExtend": false
    }
  },
