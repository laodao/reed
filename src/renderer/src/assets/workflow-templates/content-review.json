      { "id": "rev_1", "type": "human-review", "name": "人工审核", "position": { "x": 500, "y": 220 }, "config": { "payload": "{{llm_1.content}}", "timeoutMs": null, "timeoutPolicy": "fail", "interaction": "input", "editableFields": [{ "key": "output_result", "label": "内容", "type": "string" }] } },
      { "id": "report_1", "type": "report", "name": "终稿报告", "position": { "x": 720, "y": 220 }, "config": { "title": "{{start.topic}}", "template": "# {{start.topic}}\n\n{{rev_1.output_result}}", "format": "markdown" } },
      { "id": "end", "type": "end", "name": "结束", "position": { "x": 940, "y": 220 }, "config": {} }
