              "label": "其他要求",
              "type": "textarea"
            },
            {
              "key": "base_asset_id",
              "label": "基底资产 ID（修订模式：填上一次运行产出的资产 ID，本次内容将追加为该资产的新版本）",
              "type": "string"
            },
            {
              "key": "current_content",
              "label": "已有成稿（修订模式）",
              "type": "textarea"
            },
            {
              "key": "feedback",
              "label": "修改意见（修订模式）",
              "type": "textarea"
            },
            {
              "key": "model",
              "label": "写作模型",
              "type": "model",
              "required": true
            },
            {
              "key": "libaiModel",
              "label": "去AI味模型（建议与写作模型不同族，保证独立视角）",
              "type": "model",
              "required": true
            }
          ]
        }
      },
      {
        "id": "ws",
        "type": "skill-call",
        "name": "风格库写作（writing-styles）",
        "position": {
          "x": 300,
          "y": 300
        },
        "config": {
          "skillId": "writing-styles",
          "inputs": [
            {
              "key": "topic",
              "value": "{{start.topic}}"
            },
            {
              "key": "material",
              "value": "{{start.material}}"
            },
            {
              "key": "style",
              "value": "{{start.style}}"
            },
            {
              "key": "platform",
              "value": "{{start.platform}}"
            },
            {
              "key": "word_count",
              "value": "{{start.word_count}}"
            },
            {
              "key": "extra",
              "value": "{{start.extra}}"
            },
            {
              "key": "current_content",
              "value": "{{start.current_content}}"
            },
            {
              "key": "feedback",
              "value": "{{start.feedback}}"
            }
          ],
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}",
          "maxTokens": 16384
        }
      },
      {
        "id": "libai",
        "type": "skill-call",
        "name": "去AI味（libai-skill）",
        "position": {
          "x": 560,
          "y": 300
        },
        "config": {
          "skillId": "libai-skill",
          "inputs": [
            {
              "key": "source_text",
              "value": "{{ws.content}}"
            },
            {
              "key": "intensity",
              "value": "{{start.intensity}}"
            },
            {
              "key": "keep",
              "value": "{{start.keep}}"
            }
          ],
          "providerConfigId": "{{start.libaiModel.providerConfigId}}",
          "modelId": "{{start.libaiModel.modelId}}",
          "maxTokens": 32768
        }
      },
      {
        "id": "pack",
        "type": "code",
        "name": "终稿切分",
        "position": {
          "x": 820,
          "y": 300
        },
        "config": {
          "language": "js",
          "inputs": [
            {
              "key": "ws",
              "value": "{{ws.content}}"
            },
            {
              "key": "libai",
              "value": "{{libai.content}}"
            }
          ],
          "code": "const ws = String(inputs.ws || '')\nconst libai = String(inputs.libai || '')\nconst SPLIT = '=====FINAL====='\nlet final = ''\nlet diagnosis = ''\nconst i = libai.indexOf(SPLIT)\nif (i >= 0) {\n  diagnosis = libai.slice(0, i).trim()\n  final = libai.slice(i + SPLIT.length).trim()\n} else {\n  final = libai.trim()\n}\nconst fallbackUsed = !final\nif (!final) final = ws\nlet wsArticle = ws\nlet wsAppendix = ''\nconst m = ws.search(/\\n#{1,4}\\s*深度自检/)\nif (m > 0) {\n  wsArticle = ws.slice(0, m).trim()\n  wsAppendix = ws.slice(m).trim()\n}\nif (!wsAppendix) wsAppendix = wsArticle.length < ws.length ? '' : '（写作阶段未输出自检附文）'\nreturn { final, diagnosis: diagnosis || '（未产出诊断段）', appendix: wsAppendix || '（无）', fallbackUsed, wsArticle }"
        }
      },
      {
        "id": "report1",
        "type": "report",
        "name": "报告拼装",
        "position": {
          "x": 1080,
          "y": 300
        },
        "config": {
          "title": "{{start.topic}}（风格库长文）",
          "format": "markdown",
          "template": "# {{start.topic}}\n\n{{pack.result.final}}\n\n---\n\n## 附一：写作阶段自检与配图清单\n\n{{pack.result.appendix}}\n\n## 附二：去 AI 味诊断\n\n{{pack.result.diagnosis}}\n\n---\n\n*由 The Bot「深度长文写作（风格库）」工作流生成*"
        }
      },
      {
        "id": "save1",
        "type": "save-asset",
        "name": "终稿存资产",
        "position": {
          "x": 1340,
          "y": 300
        },
        "config": {
          "content": "{{pack.result.final}}",
          "kind": "text",
          "category": "text",
          "subCategory": "长文",
          "name": "{{start.topic}}",
          "tags": "长文,风格库,{{start.platform}}",
          "versioned": true,
          "versionOfAssetId": "{{start.base_asset_id}}",
          "feedback": "{{start.feedback}}"
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "结束",
        "position": {
          "x": 1600,
          "y": 300
        },
        "config": {}
      }
