{
  "kind": "the-bot-workflow",
  "formatVersion": 1,
  "name": "[内置] 深度长文写作（风格库）",
  "description": "技能库驱动的长文管线：writing-styles 风格库技能（按主题判定文体→选风格卡→按卡片结构/钩子/语域/深度阶梯写作，拒绝平铺直叙；素材非空=纪实写作事实锁定素材；填入已有成稿+修改意见=修订模式）→ libai-skill 去AI味技能（七维诊断取证→分层改写→质检，独立模型执行）→ 终稿拼装（附写作自检/配图清单与去AI味诊断）→ 存资产。版本管理：首运行 versioned 记 v1；修订运行填「基底资产 ID」（上次产出的资产）+「已有成稿」+「修改意见」→ 内容追加为新版本并就地更新，资产中心「版本」可查看/回滚（append-only）。",
  "category": "内容创作",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "开始",
        "position": {
          "x": 40,
          "y": 300
        },
        "config": {
          "inputs": [
            {
              "key": "topic",
              "label": "主题",
              "type": "string",
              "required": true
            },
            {
              "key": "material",
              "label": "研究素材（「主题深度研究」报告/资料全文；非空=纪实写作，事实锁定素材）",
              "type": "textarea"
            },
            {
              "key": "style",
              "label": "写作风格",
              "type": "select",
              "defaultValue": "auto",
              "options": [
                {
                  "label": "自动判断（按主题选最合适的风格）",
                  "value": "auto"
                },
                {
                  "label": "时政深度·书面分析体（局势分析/推演/研判）",
                  "value": "affairs-formal"
                },
                {
                  "label": "深度叙事·说书杂谈（卢克文式，枭雄沉浮/戏剧性事件）",
                  "value": "luke-narrative"
                },
                {
                  "label": "深度叙事·人物特稿（历史人物命运）",
                  "value": "luke-feature"
                },
                {
                  "label": "深度叙事·战局复盘（军事/比赛/突发事件）",
                  "value": "luke-war"
                },
                {
                  "label": "科技解读·科普特稿（诺奖/新技术/科研突破，类比通俗化）",
                  "value": "science-explainer"
                },
                {
                  "label": "财经产业史诗（远川式行业深挖）",
                  "value": "finance-story"
                },
                {
                  "label": "调查特稿（系统批判+个体故事）",
                  "value": "feature-report"
                },
                {
                  "label": "情感共鸣文（深度好文体）",
                  "value": "emotional"
                },
                {
                  "label": "干货教程（方法论/知识分享）",
                  "value": "knowledge"
                },
                {
                  "label": "知乎高赞回答体",
                  "value": "zhihu-answer"
                },
                {
                  "label": "小红书清单体/种草体",
                  "value": "listicle"
                },
                {
                  "label": "短视频口播脚本",
                  "value": "script-spoken"
                }
              ]
            },
            {
              "key": "platform",
              "label": "发布平台",
              "type": "select",
              "defaultValue": "公众号",
              "options": [
                {
                  "label": "公众号",
                  "value": "公众号"
                },
                {
                  "label": "知乎",
                  "value": "知乎"
                },
                {
                  "label": "小红书",
                  "value": "小红书"
                },
                {
                  "label": "抖音/视频号口播",
                  "value": "抖音口播"
                },
                {
                  "label": "头条/百家号",
                  "value": "头条"
                },
                {
                  "label": "B站专栏",
                  "value": "B站专栏"
                }
              ]
            },
            {
              "key": "word_count",
              "label": "目标字数",
              "type": "string",
              "defaultValue": "3000字左右"
            },
            {
              "key": "intensity",
              "label": "去AI味强度",
              "type": "select",
              "defaultValue": "标准",
              "options": [
