{
  "kind": "the-bot-workflow",
  "formatVersion": 1,
  "name": "[内置] 电商详情图",
  "description": "商品图+卖点+规格 → 先按卖点/规格规划 N 张，再逐张生成「卖点宣传卡」（大标题+说明+卖点特效图+参数，文字合到图中）",
  "category": "ecommerce",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "开始",
        "position": { "x": 40, "y": 200 },
        "config": {
          "inputs": [
            { "key": "productImage", "label": "商品图片", "type": "file", "required": true },
            { "key": "productInfo", "label": "商品信息/卖点", "type": "textarea", "required": true },
            { "key": "productCategory", "label": "产品类型", "type": "select", "required": true, "options": [
              { "label": "数码家电", "value": "digital" },
              { "label": "美妆个护", "value": "beauty" },
              { "label": "食品饮料", "value": "food" },
              { "label": "服饰鞋包", "value": "apparel" },
              { "label": "家居日用", "value": "home" },
              { "label": "母婴玩具", "value": "baby" },
              { "label": "运动户外", "value": "sports" },
              { "label": "宠物用品", "value": "pet" },
              { "label": "其他", "value": "other" }
            ] },
            { "key": "style", "label": "风格", "type": "select", "defaultValue": "tech", "options": [
              { "label": "简约", "value": "minimal" },
              { "label": "高端", "value": "premium" },
              { "label": "活力", "value": "vibrant" },
              { "label": "国潮", "value": "guochao" },
              { "label": "科技感", "value": "tech" },
              { "label": "自然", "value": "natural" }
            ] },
            { "key": "specPreset", "label": "图片规格（竖版）", "type": "select", "defaultValue": "xiaohongshu", "options": [
              { "label": "通用 1:1", "value": "generic1x1" },
              { "label": "小红书 3:4 竖图", "value": "xiaohongshu" },
              { "label": "抖音电商 3:4", "value": "douyin" },
              { "label": "自定义尺寸", "value": "custom" }
            ], "description": "详情图建议竖版；竖版平台用对应比例" },
            { "key": "maxSlides", "label": "卖点宣传图张数", "type": "number", "defaultValue": 4, "validation": { "min": 2, "max": 8 }, "description": "按卖点/规格规划几张（每张一个卖点/规格点，图文合一）" },
            { "key": "model", "label": "图像模型", "type": "model", "modelTypes": ["image"], "required": true, "description": "商品一致性关键：请选支持图像编辑/主体保留的模型（如火山 Seedream 4.5/5.0、百炼 Qwen-Image-Edit）" },
            { "key": "textModel", "label": "文案模型", "type": "model", "modelTypes": ["text", "multimodal"], "required": true }
          ]
        }
      },
      {
        "id": "detailPlan",
        "type": "llm-chat",
        "name": "详情图规划（卖点×规格）",
        "position": { "x": 320, "y": 200 },
        "config": {
          "systemPrompt": "你是资深电商详情策划。根据商品信息、卖点、规格与产品类型、风格，规划 N 张「卖点宣传图」（每张 = 一个卖点或规格点，图文合一）。\n\n【数量约束】slides 数组长度必须严格等于 {{start.maxSlides}}。\n\n【每张介绍图 = 一个卖点/规格点】逐张拆解，聚焦一个明确的卖点或规格点（如 高速马达/风力、负离子/柔顺、精准温控、磁吸配件、轻巧便携、容量、材质、油耗、续航等），每张输出：\n{id: 序号, title: 该点标题（中文，8-20 字，突出卖点）, desc: 说明文字（中文，40-80 字，讲清该点带来的好处）, prompt: 完整英文图像编辑指令, specs: [{label,value}]（2-4 个参数点，从商品信息/规格提炼，如 转速/功率/容量/材质/寿命/音量）, negativePrompt}\n\n【商品外观锁定（最高优先级）】\n商品外观以用户上传的商品参考图为准（生成阶段会把参考图作为编辑底图喂给图像编辑模型）。因此 prompt 必须写成【图像编辑指令】而非从零描述的生成式 prompt——格式：'Keep the product in the reference image completely unchanged (same shape, color, material, texture, pattern, logo). Only change the background/scene/composition to: ...'；不要重述商品外观细节，只描述「体现该卖点/规格点」的画面。\n\n【卖点视觉化】\n配图要能表达该卖点/规格点：高速风力→气流/飞扬发丝/动态；负离子→柔顺亮泽发丝；恒温→温暖舒适氛围；磁吸配件→圆环/风嘴特写；容量/材质→对应特写或场景；仅只改变背景/场景/构图/道具/氛围。\n\n【禁文字】配图中禁止出现任何文字（文字由图卡排版模板呈现）；negativePrompt 追加：text, letters, characters, typography。\n\n【风格与质感一致】保持参考图的整体绘画风格与质感（插画则插画、照片则照片）。\n\n【图片规格】配图尺寸按用户所选规格（{{start.specPreset}}）：通用1:1→1024x1024；小红书/抖音电商 3:4→1080x1440（竖版）；自定义→{{start.customWidth}}x{{start.customHeight}}。\n\n只输出 JSON 对象：{slides: [...]}。",
          "prompt": "商品信息：{{start.productInfo}}\n产品类型：{{start.productCategory}}\n风格：{{start.style}}\n图片规格：{{start.specPreset}}\n卖点宣传图张数：{{start.maxSlides}}\n\n请输出 JSON 对象。",
          "jsonMode": true,
          "providerConfigId": "{{start.textModel.providerConfigId}}",
          "modelId": "{{start.textModel.modelId}}"
        }
      },
      {
        "id": "loop1",
        "type": "loop",
        "name": "逐张生成（卖点宣传卡）",
        "position": { "x": 560, "y": 200 },
        "config": { "listExpression": "{{detailPlan.parsed.slides}}", "emptyPolicy": "skip" }
      },
      {
        "id": "img1",
        "type": "image-gen",
        "name": "生成卖点特效图",
        "position": { "x": 800, "y": 160 },
        "config": {
          "prompt": "{{loop1.item.prompt}}",
          "negativePrompt": "{{loop1.item.negativePrompt}}",
          "width": 1080,
          "height": 1080,
          "count": 1,
          "referenceImages": "{{start.productImage.path}}",
          "promptExtend": false,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "cardMd",
        "type": "code",
        "name": "拼装卖点卡 markdown",
        "position": { "x": 1040, "y": 160 },
        "config": {
          "code": "const it = inputs.sellPoint || {};\nconst url = String(inputs.imgUrl || '');\nconst specs = Array.isArray(it.specs) ? it.specs : [];\nlet md = String(it.desc || '');\nmd += '\\n\\n![卖点](' + url + ')';\nif (specs.length) {\n  md += '\\n\\n| 参数 | 说明 |\\n|---|---|\\n' + specs.map(x => '| ' + (x.label || '') + ' | ' + (x.value || '') + ' |').join('\\n');\n}\nreturn { markdown: md };",
          "inputs": [
            { "key": "sellPoint", "value": "{{loop1.item}}" },
            { "key": "imgUrl", "value": "{{img1.images.0.localUrl}}" }
          ]
        }
      },
      {
        "id": "card1",
        "type": "report-image",
        "name": "渲染卖点宣传卡",
        "position": { "x": 1280, "y": 200 },
        "config": {
          "title": "{{loop1.item.title}}",
          "template": "{{cardMd.result.markdown}}",
          "templateId": "ecommerceSellpoint",
          "width": 1080
        }
      },
      {
        "id": "saveCard",
        "type": "save-asset",
        "name": "保存卖点宣传卡",
        "position": { "x": 1520, "y": 200 },
        "config": {
          "content": "{{card1.filePath}}",
          "kind": "file",
          "category": "image",
          "subCategory": "电商详情",
          "name": "详情-{{loop1.index}}-{{loop1.item.title}}",
          "tags": "电商,详情,{{loop1.item.title}},{{start.productCategory}}",
          "groupName": "电商详情图-{{sys.today}}",
          "passthrough": { "slideTitle": "{{loop1.item.title}}", "slideDesc": "{{loop1.item.desc}}" }
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "结束",
        "position": { "x": 1760, "y": 200 },
        "config": {}
      }
    ],
    "edges": [
      { "id": "e1", "sourceNodeId": "start", "targetNodeId": "detailPlan", "kind": "normal" },
      { "id": "e2", "sourceNodeId": "detailPlan", "targetNodeId": "loop1", "kind": "normal" },
      { "id": "e8", "sourceNodeId": "loop1", "targetNodeId": "img1", "kind": "loop-body" },
      { "id": "e9", "sourceNodeId": "img1", "targetNodeId": "cardMd", "kind": "normal" },
      { "id": "e10", "sourceNodeId": "cardMd", "targetNodeId": "card1", "kind": "normal" },
      { "id": "e11", "sourceNodeId": "card1", "targetNodeId": "saveCard", "kind": "normal" },
      { "id": "e12", "sourceNodeId": "saveCard", "targetNodeId": "loop1", "kind": "loop-back" },
      { "id": "e13", "sourceNodeId": "loop1", "targetNodeId": "end", "kind": "loop-done" }
    ]
  },
  "triggers": [],
  "settings": null
}
