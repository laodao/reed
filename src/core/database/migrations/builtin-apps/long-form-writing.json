            },
            {
              "key": "mode",
              "label": "写作模式",
              "type": "select",
              "defaultValue": "auto",
              "options": [
                {
                  "label": "自动（素材非空=纪实长文，空=小说）",
                  "value": "auto"
                },
                {
                  "label": "纪实长文（必须提供素材）",
                  "value": "nonfiction"
                },
                {
                  "label": "小说/虚构",
