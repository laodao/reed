            {
              "key": "base_asset_id",
              "label": "基底资产 ID（修订续链：填上次运行产出的资产 ID，终稿将追加为该资产新版本）",
              "type": "string"
            },
            {
              "key": "current_content",
              "label": "已有成稿（修订模式；非空=跳过创作管线，直接按意见修订）",
