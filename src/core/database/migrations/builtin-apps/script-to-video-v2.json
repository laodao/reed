{
  "kind": "the-bot-workflow",
  "formatVersion": 1,
  "name": "[内置] 短视频脚本生成视频V2（素材前置）",
  "description": "脚本/主题+多知识库 → 视频类型预设装配 → 大纲生成与审核 → 分镜拆解（底图资产自动匹配）→ 逐镜素材生产（提示词包+文生图，参考图资产引用）→ 图文素材板整体审核 → 逐片段视频生成（逐镜确认，ComfyUI H3）→ 配音+烧字幕+合成 → 大纲/素材板/成片存档。",
  "category": "视频制作",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "开始（脚本/主题+KB/风格/资产引用）",
        "position": {
          "x": 40,
          "y": 600
        },
        "config": {
          "inputs": [
            {
              "key": "scriptSource",
              "label": "脚本来源",
              "type": "select",
              "required": true,
              "defaultValue": "topic",
              "options": [
                {
                  "label": "粘贴脚本文案（text）",
                  "value": "text"
                },
                {
                  "label": "引用脚本/文案资产（asset）",
                  "value": "asset"
                },
                {
                  "label": "主题+要点，从知识库生成脚本与大纲（topic）",
                  "value": "topic"
                }
              ]
            },
            {
              "key": "scriptText",
              "label": "脚本文案（粘贴，可为空）",
              "type": "textarea",
              "required": false,
              "defaultValue": "",
              "help": "与 V1 相同的完整脚本 markdown；留空则由大纲阶段按主题+知识库生成"
            },
            {
              "key": "topic",
              "label": "选题主题（scriptSource=topic 或脚本文案为空时使用）",
              "type": "string",
              "required": false,
              "defaultValue": ""
            },
            {
              "key": "keyPoints",
              "label": "要点/口径期望（可选）",
              "type": "textarea",
              "required": false,
              "defaultValue": "",
              "help": "希望覆盖的要点、涉及口径、倾向结论等"
            },
            {
              "key": "scriptAssetIds",
              "label": "脚本/文案资产（多选，scriptSource=asset）",
              "type": "select-dynamic",
              "source": "assets:text",
              "multi": true,
              "required": false,
              "help": "资产中心文本类资产多选（值=资产 ID），多个资产正文会合并引用"
            },
            {
              "key": "knowledgeBaseIds",
              "label": "知识库（多选，脚本与大纲的事实口径参考）",
              "type": "select-dynamic",
              "source": "knowledgeBases",
              "multi": true,
              "required": false
            },
            {
              "key": "videoType",
              "label": "视频类型预设",
              "type": "select",
              "required": true,
              "defaultValue": "financial-deep",
              "options": [
                {
                  "label": "财经深度",
                  "value": "financial-deep"
                },
                {
                  "label": "资讯口播",
                  "value": "news-talk"
                },
                {
                  "label": "知识科普",
                  "value": "knowledge"
                },
                {
                  "label": "电商种草",
                  "value": "ecommerce"
                },
                {
                  "label": "品牌宣传",
                  "value": "brand"
                },
                {
                  "label": "旅行记录",
                  "value": "travel"
                }
              ]
            },
            {
              "key": "videoStyle",
              "label": "自由风格叠加（可选）",
              "type": "textarea",
              "required": false,
              "defaultValue": ""
            },
            {
              "key": "referenceAssetIds",
              "label": "参考图资产（多选，作风格/主体参考）",
              "type": "select-dynamic",
              "source": "assets:image",
              "multi": true,
              "required": false,
              "help": "图片资产多选；生成时取第一张作参考图生图"
            },
            {
              "key": "baseImageAssetIds",
              "label": "底图资产（多选，供镜头直接作素材）",
              "type": "select-dynamic",
              "source": "assets:image",
              "multi": true,
              "required": false,
              "help": "当某镜画面主体与某张底图一致时直接使用（拆解阶段自动匹配索引）"
            },
            {
              "key": "width",
              "label": "视频宽度",
              "type": "number",
              "defaultValue": 704
            },
            {
              "key": "height",
              "label": "视频高度",
              "type": "number",
              "defaultValue": 1248
            },
            {
              "key": "voiceId",
              "label": "配音音色",
              "type": "string",
              "required": true,
              "defaultValue": ""
            },
            {
              "key": "voiceProviderConfigId",
              "label": "配音 Provider",
              "type": "select-dynamic",
              "source": "providerConfigs",
              "required": true
            },
            {
              "key": "videoProviderConfigId",
              "label": "视频 Provider",
              "type": "select-dynamic",
              "source": "providerConfigs",
              "required": true
            },
            {
              "key": "videoModelId",
              "label": "视频模型 ID",
              "type": "string",
              "required": true,
              "defaultValue": "h3"
            },
            {
              "key": "videoQuality",
              "label": "H3 画质档",
              "type": "select",
              "required": false,
              "defaultValue": "high",
              "options": [
                {
                  "label": "高清 high（704×1248 全质量）",
                  "value": "high"
                },
                {
                  "label": "快速 low（480×864）",
                  "value": "low"
                }
              ],
              "help": "ComfyUI H3：高清慢、快速档数倍提速（成片分辨率仍按 width/height 合成）"
            },
            {
              "key": "h3Steps",
              "label": "H3 采样步数",
              "type": "number",
              "defaultValue": 20,
              "help": "20=全质量（每镜约 5~15 分钟）；4=turbo（数倍提速，适合长视频试跑）"
            },
            {
              "key": "imageProviderConfigId",
              "label": "文生图 Provider",
              "type": "select-dynamic",
              "source": "providerConfigs",
              "required": true
            },
            {
              "key": "imageModelId",
              "label": "文生图模型 ID",
              "type": "string",
              "required": true,
              "defaultValue": "krea2"
            },
            {
              "key": "bgmPath",
              "label": "背景音乐（可选）",
              "type": "string",
              "required": false,
              "defaultValue": ""
            },
            {
              "key": "model",
              "label": "文案/拆解模型",
              "type": "model",
              "modelTypes": [
                "text"
              ],
              "required": true
            }
          ]
        }
      },
      {
        "id": "readScript",
        "type": "read-assets",
        "name": "读取脚本/文案资产",
        "position": {
          "x": 320,
          "y": 420
        },
        "config": {
          "assetIds": "{{start.scriptAssetIds}}"
        }
      },
      {
        "id": "readRef",
        "type": "read-assets",
        "name": "读取参考图资产",
        "position": {
          "x": 320,
          "y": 560
        },
        "config": {
          "assetIds": "{{start.referenceAssetIds}}"
        }
      },
      {
        "id": "readBase",
        "type": "read-assets",
        "name": "读取底图资产",
        "position": {
          "x": 320,
          "y": 700
        },
        "config": {
          "assetIds": "{{start.baseImageAssetIds}}"
        }
      },
      {
        "id": "refPick",
        "type": "code",
        "name": "参考图取首张",
        "position": {
          "x": 600,
          "y": 560
        },
        "config": {
          "code": "const refs = inputs.refs || [];\nreturn { first: (Array.isArray(refs) && refs.length > 0) ? refs[0] : '' };",
          "inputs": [
            {
              "key": "refs",
              "value": "{{readRef.imagePaths}}"
            }
          ]
        }
      },
      {
        "id": "kbQuery",
        "type": "kb-query-multi",
        "name": "多知识库检索参考",
        "position": {
          "x": 600,
          "y": 420
        },
        "config": {
          "knowledgeBaseIds": "{{start.knowledgeBaseIds}}",
          "query": "{{start.topic}} {{start.keyPoints}}",
          "topKPerKb": 6,
          "maxResults": 24
        }
      },
      {
        "id": "kbText",
        "type": "code",
        "name": "KB 结果转文本",
        "position": {
          "x": 760,
          "y": 420
        },
        "config": {
          "code": "const rows = Array.isArray(inputs.rows) ? inputs.rows : [];\nif (rows.length === 0) return { text: '' };\nreturn { text: rows.map((r, i) => '【来源' + (i + 1) + '｜库:' + String(r.knowledgeBaseId || '') + '｜文档:' + String(r.documentName || '') + '】' + String(r.content || '').slice(0, 500)).join('\\n\\n') };",
          "inputs": [
            {
              "key": "rows",
              "value": "{{kbQuery.results}}"
            }
          ]
        }
      },
      {
        "id": "scriptSrc",
        "type": "code",
        "name": "整理脚本文案来源",
        "position": {
          "x": 760,
          "y": 700
        },
        "config": {
          "code": "const mode = String(inputs.mode || 'topic');\nconst assetText = String(inputs.assetText || '');\nconst text = String(inputs.scriptText || '');\nif (mode === 'asset') return { text: assetText };\nif (mode === 'text') return { text };\nreturn { text: '' }; // topic：由大纲阶段按主题+KB 生成",
          "inputs": [
            {
              "key": "mode",
              "value": "{{start.scriptSource}}"
            },
            {
              "key": "scriptText",
              "value": "{{start.scriptText}}"
            },
            {
              "key": "assetText",
              "value": "{{readScript.textJoined}}"
            }
          ]
        }
      },
      {
        "id": "preset",
        "type": "video-preset",
        "name": "视频类型预设装配",
        "position": {
          "x": 600,
          "y": 700
        },
        "config": {
          "videoType": "{{start.videoType}}",
          "freeStyle": "{{start.videoStyle}}"
        }
      },
      {
        "id": "outlineGen",
        "type": "llm-chat",
        "name": "大纲生成（脚本/主题+知识库）",
        "position": {
          "x": 900,
          "y": 560
        },
        "config": {
          "systemPrompt": "你是资深短视频策划。输出可执行大纲 JSON。\n【视频类型/风格规范】\n{{preset.promptBlock}}\n【脚本来源】已有脚本则精炼为大纲；仅有主题/要点时结合知识库参考生成完整口播与大纲。\n【知识库参考】（为空则忽略，不为空则事实口径须以其为准并标注来源：官方通报/当事人自述/媒体报道/年报数据等）\n{{kbText.result.text}}\n【脚本/文案资产或粘贴文本参考】（为空则忽略）\n{{scriptSrc.result.text}}\n【主题与要点】\n主题：{{start.topic}}\n要点：{{start.keyPoints}}\n【产出 JSON】{\"title\":\"标题\",\"positioning\":\"一句话定位\",\"narration\":\"全片完整口播（可分段，用 | 分句）\",\"sections\":[{\"role\":\"段落作用\",\"keyPoint\":\"本段要点\",\"narration\":\"本段口播句\"}],\"structureNote\":\"结构说明\"}\n口播面向中文普通话，总时长估算 ≤300 秒（约 ≤20 镜）；事实与观点分离，涉来源口径标注。",
          "prompt": "请综合以上素材输出大纲 JSON（无脚本文案且无知识库参考时，直接按主题与视频类型创作）。",
          "jsonMode": true,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "outlineMd",
        "type": "code",
        "name": "大纲渲染 markdown",
        "position": {
          "x": 1180,
          "y": 560
        },
        "config": {
          "code": "const o = inputs.outline || {};\nconst secs = Array.isArray(o.sections) ? o.sections : [];\nconst rows = secs.map((s, i) => '- **段落' + (i + 1) + '** ' + String(s.role || '') + '｜' + String(s.keyPoint || '') + '｜口播：' + String(s.narration || '')).join('\\n');\nreturn { md: '## ' + String(o.title || '') + '\\n\\n**定位**：' + String(o.positioning || '') + '\\n\\n**结构**：' + String(o.structureNote || '') + '\\n\\n## 口播全文\\n\\n' + String(o.narration || '') + '\\n\\n## 分段\\n\\n' + rows };",
          "inputs": [
            {
              "key": "outline",
              "value": "{{outlineGen.parsed}}"
            }
          ]
        }
      },
      {
        "id": "outlineReview",
        "type": "human-review",
        "name": "大纲审核",
        "position": {
          "x": 1460,
          "y": 560
        },
        "config": {
          "payload": {
            "stage": "大纲审核：批准后进入分镜拆解",
            "md": "{{outlineMd.result.md}}"
          },
          "editableFields": [
            {
              "key": "md",
              "label": "大纲全文",
              "type": "string"
            }
          ],
          "timeoutMs": null,
          "timeoutPolicy": "fail"
        }
      },
      {
        "id": "baseList",
        "type": "code",
        "name": "底图清单文本",
        "position": {
          "x": 1740,
          "y": 760
        },
        "config": {
          "code": "const assets = Array.isArray(inputs.assets) ? inputs.assets : [];\nreturn { text: assets.map((a, i) => '[' + i + '] ' + (a.name || '') + (a.description ? '：' + a.description : '')).join('\\n') };",
          "inputs": [
            {
              "key": "assets",
              "value": "{{readBase.assets}}"
            }
          ]
        }
      },
      {
        "id": "shotsGen",
        "type": "llm-chat",
        "name": "分镜拆解（含底图匹配）",
        "position": {
          "x": 2020,
          "y": 560
        },
        "config": {
          "systemPrompt": "你是资深视频分镜师。依据用户确认的大纲把视频拆为 1~20 个镜头。【画面硬性要求】visual 只描述可实拍物理场景（主体/动作/环境/光线/色调/构图景别/情绪/镜头运动），禁止任何文字/UI/图形/图表/水印/贴片字幕（所有文字一律走 caption 字幕层）；每镜 1~3 句并给出运镜。\n【大纲全文（用户已审核）】\n{{outlineReview.md}}\n【可用底图资产】（名称/描述/索引，画面主体一致才选，否则 -1）：\n{{baseList.result.text}}\n【镜头规则】字幕 caption 为画面要传达的文字（会烧录为字幕）；每镜 visual 独立可执行；duration 整数秒 4~16。输出 JSON 数组结构：{\"narration\":\"全片口播（原样保留可用 | 分句）\",\"shots\":[{\"visual\":\"画面描述\",\"caption\":\"该镜字幕短句\",\"duration\":秒数字,\"baseChoice\":-1}]} baseChoice=-1 表示不用底图资产；当存在与画面主体一致的底图资产时填其索引(>=0)。镜头总数 1~20。",
          "prompt": "请基于以上大纲与底图清单输出镜头 JSON。",
          "jsonMode": true,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "splitShots",
        "type": "code",
        "name": "拆分镜头（生成/底图）",
        "position": {
          "x": 2300,
          "y": 560
        },
        "config": {
          "code": "const shots = Array.isArray(inputs.shots) ? inputs.shots : [];\nif (shots.length === 0) throw new Error('分镜拆解结果为空：请检查脚本/大纲内容后重试');\nconst hasBase = Array.isArray(inputs.bases) && inputs.bases.length > 0;\nconst gen = [];\nconst base = [];\nshots.forEach((s, i) => {\n  const s2 = Object.assign({}, s, { _origIndex: i });\n  const bi = hasBase ? Number(s.baseChoice) : -1;\n  if (Number.isInteger(bi) && bi >= 0 && bi < inputs.bases.length) {\n    s2.baseImagePath = inputs.bases[bi].path || '';\n    s2.baseImageUrl = inputs.bases[bi].url || '';\n    s2.baseImageName = inputs.bases[bi].name || '';\n    base.push(s2);\n  } else {\n    s2.baseChoice = -1;\n    gen.push(s2);\n  }\n});\nreturn { shots, gen, base };",
          "inputs": [
            {
              "key": "shots",
              "value": "{{shotsGen.parsed.shots}}"
            },
            {
              "key": "bases",
              "value": "{{readBase.assets}}"
            }
          ]
        }
      },
      {
        "id": "loopMat",
        "type": "loop",
        "name": "素材循环（生成镜头）",
        "position": {
          "x": 2600,
          "y": 560
        },
        "config": {
          "listExpression": "{{splitShots.result.gen}}",
          "emptyPolicy": "skip"
        }
      },
      {
        "id": "shotPack",
        "type": "llm-chat",
        "name": "片段提示词包",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
          "systemPrompt": "为单个镜头产出可执行素材包（JSON）：{\"visual\":\"画面描述（服从大纲/风格；仅实拍物理场景、无文字、含运镜）\",\"caption\":\"字幕短句\",\"duration\":秒,\"prompt\":\"给文生图的完整画面提示词（已含风格与参考图说明）\"}\n【预设规范】\n{{preset.promptBlock}}\n【参考图提示】画面风格与主体须贴合参考图（若有）。",
          "prompt": "大纲段落背景：{{loopMat.item.sectionIdx}}\n镜头画面要点：{{loopMat.item.visual}}\n字幕：{{loopMat.item.caption}}\n时长：{{loopMat.item.duration}}秒\n\n输出该镜头素材包 JSON。",
          "jsonMode": true,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "imgShot",
        "type": "image-gen",
        "name": "文生图(镜头画面)",
        "position": {
          "x": 3000,
          "y": 560
        },
        "config": {
          "prompt": "{{shotPack.parsed.prompt}}（竖版构图；写实、干净、无任何文字）",
          "negativePrompt": "文字、字体、logo、水印、UI 元素、图标、按钮、弹窗、乱码、涂鸦、图形、表格、图表、标注、贴片字幕、卡通",
          "providerConfigId": "{{start.imageProviderConfigId}}",
          "modelId": "{{start.imageModelId}}",
          "width": "{{start.width}}",
          "height": "{{start.height}}",
          "referenceImages": "{{refPick.result.first}}",
          "promptExtend": false
        }
      },
      {
        "id": "matItem",
        "type": "code",
        "name": "素材项（生成图）",
        "position": {
          "x": 3200,
          "y": 560
        },
        "config": {
          "code": "const list = Array.isArray(inputs.img) ? inputs.img : ((inputs.img && inputs.img.images) || []);\nconst img = (list && list[0]) || {};\nconst pack = inputs.pack || {};\nreturn { _origIndex: inputs.item._origIndex, visual: pack.visual || inputs.item.visual, caption: pack.caption || inputs.item.caption,\n  duration: Number(pack.duration) > 0 ? pack.duration : inputs.item.duration,\n  prompt: pack.prompt || '', baseImagePath: '', imagePath: img.path || '', imageUrl: img.localUrl || img.url || '', imageAssetId: '' };",
          "inputs": [
            {
              "key": "item",
              "value": "{{loopMat.item}}"
            },
            {
              "key": "pack",
              "value": "{{shotPack.parsed}}"
            },
            {
              "key": "img",
              "value": "{{imgShot.images}}"
            }
          ]
        }
      },
      {
        "id": "loopBase",
        "type": "loop",
        "name": "素材循环（直接用底图镜头）",
        "position": {
          "x": 2600,
          "y": 800
        },
        "config": {
          "listExpression": "{{splitShots.result.base}}",
          "emptyPolicy": "skip"
        }
      },
      {
        "id": "matBase",
        "type": "code",
        "name": "素材项（底图直用）",
        "position": {
          "x": 2800,
          "y": 800
        },
        "config": {
          "code": "const it = inputs.item || {};\nreturn { _origIndex: it._origIndex, visual: it.visual || '', caption: it.caption || '', duration: Number(it.duration) > 0 ? it.duration : 5,\n  prompt: it.visual || '', baseImagePath: it.baseImagePath || '', imagePath: it.baseImagePath || '', imageUrl: it.baseImageUrl || it.baseImagePath || '', imageAssetName: it.baseImageName || '' };",
          "inputs": [
            {
              "key": "item",
              "value": "{{loopBase.item}}"
            }
          ]
        }
      },
      {
        "id": "boardMerge",
        "type": "code",
        "name": "素材板聚合",
        "position": {
          "x": 3400,
          "y": 560
        },
        "config": {
