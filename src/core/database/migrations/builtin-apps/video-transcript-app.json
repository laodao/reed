{
  "kind": "the-bot-workflow",
  "formatVersion": 1,
  "name": "[内置] 视频文案提取",
  "description": "B站/YouTube/直链/本地视频 → 提取音频 → 语音识别转写（超长自动分段）→ AI 按风格整理成文案 → 报告 + 存资产",
  "category": "media",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "name": "开始",
        "position": { "x": 40, "y": 200 },
        "config": {
          "inputs": [
            { "key": "video", "label": "本地视频文件（可选，与链接二选一）", "type": "file" },
            { "key": "videoUrl", "label": "视频链接（B站/YouTube/直链）", "type": "string" },
            { "key": "language", "label": "语音语言", "type": "select", "defaultValue": "auto", "options": [
              { "label": "自动检测", "value": "auto" },
              { "label": "中文", "value": "zh" },
              { "label": "英文", "value": "en" }
            ] },
            { "key": "style", "label": "输出风格", "type": "select", "defaultValue": "polished", "options": [
              { "label": "精炼润色", "value": "polished" },
              { "label": "口语原味", "value": "raw" },
              { "label": "要点速记", "value": "bullets" },
              { "label": "带时间戳分段", "value": "timeline" }
            ] },
            { "key": "segmentMinutes", "label": "分段时长（分钟）", "type": "number", "defaultValue": 5 },
            { "key": "request", "label": "效果描述", "type": "textarea" },
            { "key": "asrModel", "label": "语音识别模型", "type": "model", "modelTypes": ["audio"], "required": true },
            { "key": "chatModel", "label": "文案整理模型", "type": "model", "modelTypes": ["text", "multimodal"], "required": true }
          ]
        }
      },
      {
        "id": "audio1",
        "type": "video-extract-audio",
        "name": "提取音频",
        "position": { "x": 340, "y": 200 },
        "config": { "videoPath": "{{start.video.path}}", "videoUrl": "{{start.videoUrl}}", "language": "{{start.language}}" }
      },
      {
        "id": "stt1",
        "type": "stt",
        "name": "语音识别",
        "position": { "x": 580, "y": 200 },
        "config": { "audio": "{{audio1.audioPath}}", "language": "{{start.language}}", "segmentMinutes": "{{start.segmentMinutes}}", "providerConfigId": "{{start.asrModel.providerConfigId}}", "modelId": "{{start.asrModel.modelId}}" }
      },
      {
        "id": "polish1",
        "type": "llm-chat",
        "name": "整理文案",
        "position": { "x": 820, "y": 200 },
        "config": {
          "systemPrompt": "你是视频文案整理助手。把语音识别转录整理为通顺文案。输出风格：\n- 精炼润色：修正口语、分段、去重复\n- 口语原味：保留原话，去口头禅\n- 要点速记：提炼核心观点列表\n- 带时间戳分段：按内容主题分段并标注时间\n\n只输出文案正文。",
          "prompt": "输出风格：{{start.style}}\n用户效果要求：{{start.request}}\n\n语音转录：\n{{stt1.text}}",
          "providerConfigId": "{{start.chatModel.providerConfigId}}",
          "modelId": "{{start.chatModel.modelId}}"
        }
      },
      {
        "id": "report1",
        "type": "report",
        "name": "文案输出",
        "position": { "x": 1060, "y": 200 },
        "config": { "title": "视频文案：{{audio1.videoName}}", "template": "{{polish1.content}}", "format": "markdown" }
      },
      {
        "id": "save1",
        "type": "save-asset",
        "name": "保存到资产库",
        "position": { "x": 1300, "y": 200 },
        "config": { "content": "{{polish1.content}}", "kind": "text", "category": "text", "subCategory": "视频文案", "name": "{{audio1.videoName}}文案", "tags": "视频文案" }
      },
      {
        "id": "notify1",
        "type": "app-notify",
        "name": "完成通知",
        "position": { "x": 1540, "y": 200 },
        "config": { "title": "文案已生成", "message": "视频文案提取完成：{{audio1.videoName}}，资产 ID {{save1.assetId}}", "level": "success" }
      },
      {
        "id": "end",
        "type": "end",
        "name": "结束",
        "position": { "x": 1780, "y": 200 },
        "config": {}
      }
    ],
    "edges": [
      { "id": "e1", "sourceNodeId": "start", "targetNodeId": "audio1", "kind": "normal" },
      { "id": "e2", "sourceNodeId": "audio1", "targetNodeId": "stt1", "kind": "normal" },
      { "id": "e3", "sourceNodeId": "stt1", "targetNodeId": "polish1", "kind": "normal" },
      { "id": "e4", "sourceNodeId": "polish1", "targetNodeId": "report1", "kind": "normal" },
      { "id": "e5", "sourceNodeId": "report1", "targetNodeId": "save1", "kind": "normal" },
      { "id": "e6", "sourceNodeId": "save1", "targetNodeId": "notify1", "kind": "normal" },
      { "id": "e7", "sourceNodeId": "notify1", "targetNodeId": "end", "kind": "normal" }
    ]
  },
  "triggers": [],
  "settings": null
}
