              ],
              "required": true
            }
          ]
        }
      },
      {
        "id": "readScript",
        "type": "read-assets",
        "name": "读取脚本/文案资产",
        "position": {
          "x": 320,
          "y": 420
        },
        "config": {
          "assetIds": "{{start.scriptAssetIds}}"
        }
      },
      {
        "id": "readRef",
        "type": "read-assets",
        "name": "读取参考图资产",
        "position": {
          "x": 320,
          "y": 560
        },
        "config": {
          "assetIds": "{{start.referenceAssetIds}}"
        }
      },
      {
        "id": "readBase",
        "type": "read-assets",
        "name": "读取底图资产",
        "position": {
          "x": 320,
          "y": 700
        },
        "config": {
          "assetIds": "{{start.baseImageAssetIds}}"
        }
      },
      {
        "id": "refPick",
        "type": "code",
        "name": "参考图取首张",
        "position": {
          "x": 600,
          "y": 560
        },
        "config": {
          "code": "const refs = inputs.refs || [];\nreturn { first: (Array.isArray(refs) && refs.length > 0) ? refs[0] : '' };",
          "inputs": [
            {
              "key": "refs",
              "value": "{{readRef.imagePaths}}"
            }
          ]
        }
      },
      {
        "id": "kbQuery",
        "type": "kb-query-multi",
        "name": "多知识库检索参考",
        "position": {
          "x": 600,
          "y": 420
        },
        "config": {
          "knowledgeBaseIds": "{{start.knowledgeBaseIds}}",
          "query": "{{start.topic}} {{start.keyPoints}}",
          "topKPerKb": 6,
          "maxResults": 24
        }
      },
      {
        "id": "kbText",
        "type": "code",
        "name": "KB 结果转文本",
        "position": {
          "x": 760,
          "y": 420
        },
        "config": {
          "code": "const rows = Array.isArray(inputs.rows) ? inputs.rows : [];\nif (rows.length === 0) return { text: '' };\nreturn { text: rows.map((r, i) => '【来源' + (i + 1) + '｜库:' + String(r.knowledgeBaseId || '') + '｜文档:' + String(r.documentName || '') + '】' + String(r.content || '').slice(0, 500)).join('\\n\\n') };",
          "inputs": [
            {
              "key": "rows",
              "value": "{{kbQuery.results}}"
            }
          ]
        }
      },
      {
        "id": "scriptSrc",
        "type": "code",
        "name": "整理脚本文案来源",
        "position": {
          "x": 760,
          "y": 700
        },
        "config": {
          "code": "const mode = String(inputs.mode || 'topic');\nconst assetText = String(inputs.assetText || '');\nconst text = String(inputs.scriptText || '');\nif (mode === 'asset') return { text: assetText };\nif (mode === 'text') return { text };\nreturn { text: '' }; // topic：由大纲阶段按主题+KB 生成",
          "inputs": [
            {
              "key": "mode",
              "value": "{{start.scriptSource}}"
            },
            {
              "key": "scriptText",
              "value": "{{start.scriptText}}"
            },
            {
              "key": "assetText",
              "value": "{{readScript.textJoined}}"
            }
          ]
        }
      },
      {
        "id": "preset",
        "type": "video-preset",
        "name": "视频类型预设装配",
        "position": {
          "x": 600,
          "y": 700
        },
        "config": {
          "videoType": "{{start.videoType}}",
          "freeStyle": "{{start.videoStyle}}"
        }
      },
      {
        "id": "outlineReview",
        "type": "human-review",
        "name": "大纲审核",
        "position": {
          "x": 1460,
          "y": 560
        },
        "config": {
          "payload": {
            "stage": "大纲审核：批准后进入分镜拆解",
            "md": "{{writerMd.result.md}}"
          },
          "editableFields": [
            {
              "key": "md",
              "label": "大纲全文",
              "type": "string"
            }
          ],
          "timeoutMs": null,
          "timeoutPolicy": "fail"
        }
      },
      {
        "id": "baseList",
        "type": "code",
        "name": "底图清单文本",
        "position": {
          "x": 1740,
          "y": 760
        },
        "config": {
          "code": "const assets = Array.isArray(inputs.assets) ? inputs.assets : [];\nreturn { text: assets.map((a, i) => '[' + i + '] ' + (a.name || '') + (a.description ? '：' + a.description : '')).join('\\n') };",
          "inputs": [
            {
              "key": "assets",
              "value": "{{readBase.assets}}"
            }
          ]
        }
      },
      {
        "id": "shotsGen",
        "type": "llm-chat",
        "name": "分镜拆解（含底图匹配）",
        "position": {
          "x": 2020,
          "y": 560
        },
        "config": {
          "systemPrompt": "你是资深视频分镜师。依据用户确认的大纲把视频拆为 1~20 个镜头。\n【视频类型/风格规范】\n{{preset.promptBlock}}\n【视觉策略（当前模式 {{strategy.result.mode}}）】\n{{strategy.result.policyText}}\n【素材池（asset 模式引用；imagery 模式可参考）】（名称/描述/索引）\n{{baseList.result.text}}\n【大纲全文（用户已审核）】\n{{outlineReview.md}}\n【画面硬性要求】visual 只描述可实拍物理场景（主体/动作/环境/光线/色调/构图景别/情绪/镜头运动），禁止任何文字/UI/图形/图表/水印/贴片字幕（所有文字一律走 caption 字幕层）；每镜 1~3 句并给出运镜。\n【镜头规则】字幕 caption 为画面要传达的文字（烧录为字幕）；duration 整数秒 4~16；每镜给出 concept（该镜语义主题）。\n【模式化镜头输出】依据上方“视觉策略”里的模式：\n - imagery 模式：每镜另给 imagery（意象对象：按意象表命中 + concept 细化的代表性意象画面，可拍无文字）与 visual（=该意象的可执行画面描述）。\n - asset 模式：每镜必须给 assetIdx（引用素材池索引，取值 0..{{strategy.result.baseCount}}-1）与 visual（描述该镜展示素材的角度/景别/运镜/氛围，主体来自素材，不新增文字）。\n输出 JSON 数组结构：{\"narration\":\"全片口播（原样保留可用 | 分句）\",\"shots\":[{\"concept\":\"语义主题\",\"visual\":\"画面描述\",\"caption\":\"字幕短句\",\"duration\":秒,\"imagery\":\"意象对象(仅 imagery)\",\"assetIdx\":素材索引(仅 asset)}]}。镜头总数 1~20。\n【分镜原子纪律】以“口播的 | 分句/大纲段落”为镜头原子：同一镜只承载一个事件、一个地点、一个语义点；一句口播含多个事件或地点时必须拆成多个镜头，禁止把多个场景塞进同一镜的 visual。",
          "prompt": "请基于大纲与视觉策略输出镜头 JSON（concept/imagery 或 assetIdx 依模式填写）。",
          "jsonMode": true,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "splitShots",
        "type": "code",
        "name": "拆分镜头（生成/底图）",
        "position": {
          "x": 2300,
          "y": 560
        },
        "config": {
          "code": "const shots = Array.isArray(inputs.shots) ? inputs.shots : [];\nif (shots.length === 0) throw new Error('分镜拆解结果为空：请检查脚本/大纲内容后重试');\nconst mode = String(inputs.mode || 'imagery');\nconst bases = Array.isArray(inputs.bases) ? inputs.bases : [];\nconst gen = [];\nconst base = [];\nshots.forEach(function (s, i) {\n  const s2 = Object.assign({}, s, { _origIndex: i, mode: mode });\n  if (mode === 'asset') {\n    const idx = Number(s.assetIdx);\n    if (!Number.isInteger(idx) || idx < 0 || idx >= bases.length) {\n      throw new Error('素材驱动镜头 ' + (i + 1) + ' 缺少有效素材引用（assetIdx=' + String(s.assetIdx) + '，素材池 ' + bases.length + ' 张）：请为每个镜头标注素材索引后重试');\n    }\n    s2.assetIdx = idx;\n    s2.baseImagePath = bases[idx].path || '';\n    s2.baseImageUrl = bases[idx].url || '';\n    s2.baseImageName = bases[idx].name || '';\n    s2.baseAssetId = bases[idx].assetId || bases[idx].id || '';\n    base.push(s2);\n  } else {\n    s2.assetIdx = -1;\n    gen.push(s2);\n  }\n});\nreturn { shots: shots, gen: gen, base: base, mode: mode };",
          "inputs": [
            {
              "key": "shots",
              "value": "{{shotsGen.parsed.shots}}"
            },
            {
              "key": "mode",
              "value": "{{strategy.result.mode}}"
            },
            {
              "key": "bases",
              "value": "{{readBase.assets}}"
            }
          ]
        }
      },
      {
        "id": "loopMat",
        "type": "loop",
        "name": "素材循环（生成镜头）",
        "position": {
          "x": 2600,
          "y": 560
        },
        "config": {
          "listExpression": "{{splitShots.result.gen}}",
          "emptyPolicy": "skip"
        }
      },
      {
        "id": "shotPack",
        "type": "llm-chat",
        "name": "片段提示词包",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
          "systemPrompt": "为单个镜头产出可执行素材包（JSON）：{\"concept\":\"语义主题\",\"visual\":\"画面描述（服从大纲/风格；仅实拍物理场景、无文字、含运镜）\",\"imagery\":\"意象对象（imagery 模式：依意象表命中细化为可执行画面；asset 模式填空）\",\"caption\":\"字幕短句\",\"duration\":秒,\"prompt\":\"给文生图的完整画面提示词（已含风格与参考图说明；asset 模式此字段可空）\"}\n【预设规范】\n{{preset.promptBlock}}\n【视觉策略】\n{{strategy.result.policyText}}\n【参考图提示】画面风格与主体须贴合参考图（若有）；意象化空镜禁止出现文字。\n【单场景纪律】visual 与 imagery 只描述“一个主体 + 一处环境”的单一可拍场景；严禁“先…随后…/接着切到…/再出现…”这类多场景转场拼接；对比性修辞句只取一个代表性意象。",
          "prompt": "大纲段落：{{loopMat.item.sectionIdx}}\n语义主题：{{loopMat.item.concept}}\n画面要点：{{loopMat.item.visual}}\n意象对象：{{loopMat.item.imagery}}\n字幕：{{loopMat.item.caption}}\n时长：{{loopMat.item.duration}}秒\n\n输出该镜头素材包 JSON。",
          "jsonMode": true,
          "providerConfigId": "{{start.model.providerConfigId}}",
          "modelId": "{{start.model.modelId}}"
        }
      },
      {
        "id": "imgShot",
        "type": "image-gen",
        "name": "文生图(镜头画面)",
        "position": {
          "x": 3000,
          "y": 560
        },
        "config": {
          "prompt": "{{shotPack.parsed.prompt}}（竖版构图；写实、干净、无任何文字）",
          "negativePrompt": "文字、字体、logo、水印、UI 元素、图标、按钮、弹窗、乱码、涂鸦、图形、表格、图表、标注、贴片字幕、卡通",
          "providerConfigId": "{{start.imageProviderConfigId}}",
          "modelId": "{{start.imageModelId}}",
          "width": "{{start.width}}",
          "height": "{{start.height}}",
          "referenceImages": "{{refPick.result.first}}",
          "promptExtend": false
        }
      },
      {
        "id": "matItem",
        "type": "code",
        "name": "素材项（生成图）",
        "position": {
          "x": 3200,
          "y": 560
