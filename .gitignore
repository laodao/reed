# 数据库备份目录（不进版本库；本地恢复用）
.backups/

# 随包分发的种子数据库（本地数据，不进版本库；由 scripts/prepare-seed-db.js 生成）
resources/seed/*.db
resources/seed/*.db-*
tests/reports/*
# Claude Code 本地文件：只忽略个人/临时产物，保留 commands/skills 等团队共享文件
.claude/settings.local.json
.claude/worktrees/
# 测试覆盖率报告
coverage/

# 运行日志（含 playwright console 日志）——不得入库
*.log

# 本地密钥/环境文件与编辑器产物（review P2：git add -A 曾扫入）
.env
.env.*
.history/
C:/
report.*.json

# 验证截图/界面截图：本地留证即可，不进版本库
# （已有历史截图仍被跟踪，如需一并清理需单独 git rm --cached）
progress/**/*.png
progress/*.png
scripts/.settings-shots/
*.screenshot.png

# 探查脚本导出的数据快照（体积大、可由脚本重生成，不进版本库）
progress/_*_dump.json
progress/_*_dup_pairs.json

# Agent harness 的大输出落盘文件（命令输出，不是工程产物）
.dsh-*.txt
