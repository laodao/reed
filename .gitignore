# 数据库备份目录（不进版本库；本地恢复用）
.backups/

# 随包分发的种子数据库（本地数据，不进版本库；由 scripts/prepare-seed-db.js 生成）
resources/seed/*.db
resources/seed/*.db-*
tests/reports/*
# Claude Code 本地文件：只忽略个人/临时产物，保留 commands/skills 等团队共享文件
.claude/settings.local.json
.claude/worktrees/
# 测试覆盖率报告
coverage/

# 运行日志（含 playwright console 日志）——不得入库
*.log

# 本地密钥/环境文件与编辑器产物（review P2：git add -A 曾扫入）
.env
.env.*
.history/
C:/
report.*.json

# 验证截图/界面截图：本地留证即可，不进版本库
scripts/.settings-shots/
*.screenshot.png

# Agent harness 的大输出落盘文件（命令输出，不是工程产物）
.dsh-*.txt

# 会话进度产物只留本地，不入库（诊断脚本/验证截图/过程文档）
progress/

# ZCode 会话本地目录
.zcode/

# 剧集渲染等会话产物不入库（体积大、可再生；本地保留）
outputs/*.mp4
outputs/*.mkv
outputs/*.webm
# 数据库备份/产物绝不入库（含用户数据，体积大；备份放仓库外目录）
outputs/*.db
outputs/*.db-shm
outputs/*.db-wal

# ===== 创作资产（本地保留，不入库）=====
# 天下捕快设定集/旧稿与 skill 包原始归档（docs/other/，约 12MB 二进制）
docs/other/
