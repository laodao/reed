{
  "name": "the_bot",
  "version": "2.1.0",
  "description": "The Bot - 集成多种AI能力的跨平台桌面应用",
  "main": "./out/main/index.js",
  "author": "Daoge",
  "license": "MIT",
  "homepage": "https://github.com/daoge/the_bot",
  "scripts": {
    "predev": "node scripts/clean-stale-vite-config.js",
    "dev": "set LANG=en_US.UTF-8 && set PYTHONIOENCODING=utf-8 && electron-vite dev",
    "dev:debug": "NO_AT_BRIDGE=1 electron-vite dev -- --remote-debugging-port=9222",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3 canvas nodejieba",
    "prepc:dev": "node scripts/clean-stale-vite-config.js",
    "pc:dev": "electron-vite dev -- --no-sandbox",
    "web:server:dev": "tsx watch -r tsconfig-paths/register src/web/server/index.ts",
    "prebuild": "node scripts/clean-stale-vite-config.js",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:portable": "electron-vite build && electron-builder --win dir",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,json,css,scss}\"",
    "typecheck": "vue-tsc --noEmit",
    "web:dev": "tsx watch -r tsconfig-paths/register src/web/server/index.ts",
    "web:start": "tsx -r tsconfig-paths/register src/web/server/index.ts",
    "web:client:dev": "vite --config vite.config.web.ts",
    "web:client:build": "vite build --config vite.config.web.ts",
    "test": "node scripts/vitest-electron.cjs",
    "test:unit": "node scripts/vitest-electron.cjs run tests/unit",
    "test:unit:sqlite": "node scripts/vitest-electron.cjs --sqlite-only run tests/unit",
    "test:unit:pg": "node scripts/vitest-electron.cjs run tests/unit",
    "test:coverage": "node scripts/vitest-electron.cjs run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:web": "playwright test --config=playwright.web.config.ts",
    "test:e2e:web:ui": "playwright test --config=playwright.web.config.ts --ui",
    "test:hyp3": "tsx -r tsconfig-paths/register tests/integration/episode-production/hyp3-few-shot-test.ts",
    "pg:up": "bash scripts/test-pg-up.sh",
    "pg:down": "bash scripts/test-pg-down.sh",
    "fix-encoding": "electron scripts/fix-chunk-encoding.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai-compatible": "^2.0.74",
    "@anthropic-ai/sdk": "^0.80.0",
    "@bytemd/plugin-frontmatter": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "@bytemd/vue-next": "^1.22.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@firecrawl/anydoc": "^0.2.4",
    "@firecrawl/pdf-inspector": "^1.15.0",
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.27.1",
    "@lingo-reader/epub-parser": "^0.4.6",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.1.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ai": "^6.0.277",
    "ajv": "^8.20.0",
    "apache-arrow": "^18.1.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "bytemd": "^1.22.0",
    "canvas": "^3.2.2",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.15",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "element-plus": "^2.5.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.2",
    "imapflow": "^1.7.2",
    "js-yaml": "^5.4.1",
    "jschardet": "^3.1.4",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.44",
    "mailparser": "^3.9.15",
    "mammoth": "^1.12.0",
    "marked": "^17.0.3",
    "mermaid": "^11.14.0",
    "mssql": "^10.0.4",
    "multer": "^2.1.1",
    "mysql2": "^3.24.2",
    "node-html-parser": "^7.1.0",
    "nodejieba": "^3.5.8",
    "nodemailer": "^9.0.5",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.20.0",
    "pinia": "^2.1.7",
    "pino": "^9.14.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "typeorm": "^0.3.28",
    "vue": "^3.4.19",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuedraggable": "^4.1.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "overrides": {
    "imapflow": {
      "pino": "^9.0.0"
    },
    "ai": "^6.0.277"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.21.1",
    "happy-dom": "^13.6.2",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "tailwindcss": "^3.4.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "vue-tsc": "^3.2.7"
  },
  "build": {
    "appId": "com.daoge.the_bot",
    "productName": "The Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!**/node_modules/**/{README,readme,README.md,readme.md,CHANGELOG,CHANGELOG.md,HISTORY,LICENSE,LICENSE.md,NOTICE}",
      "!**/node_modules/**/{test,tests,__tests__,docs,doc,examples,example,coverage,.github}",
      "!**/node_modules/**/*.{md,markdown,ts,flow,coffee,map,markdown}",
      "!**/node_modules/**/*.d.ts"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@lancedb/**",
      "**/node_modules/nodejieba/**",
      "**/node_modules/canvas/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "asar": true,
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "extraResources": [
      {
        "from": "resources/seed/the_bot.db",
        "to": "seed/the_bot.db",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
